# Copie este arquivo para "backend/.env" e preencha. O ".env" NUNCA vai para o GitHub.
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=google/gemma-4-26B-A4B-it
# "regras" desliga os agentes de IA e usa as regras locais.
AGENTS_MODE=

# Opcionais em desenvolvimento; necessárias no Render. Descomente apenas se for preencher.
# URLs do frontend que podem chamar a API, separadas por vírgula.
# CORS_ORIGIN=https://seu-site.netlify.app
# Onde ficam o banco e os arquivos enviados. Em produção, devem apontar para o disco persistente.
# DATABASE_PATH=/data/sqlite.db
# UPLOAD_DIR=/data/uploads
# Banco copiado para DATABASE_PATH quando esse arquivo ainda não existe.
# SEED_DATABASE_PATH=deploy/seed.db
